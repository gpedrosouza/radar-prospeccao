# =============================================================================
# Radar Prospecção — variáveis de ambiente de PRODUÇÃO
#
# Copie para .env.production e preencha TODOS os valores.
# Este arquivo NUNCA deve ser commitado (.gitignore já o exclui).
#
# Uso: docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Container Registry — imagens Docker (CI/CD)
# Prefixo das imagens publicadas pelo GitHub Actions.
# Formato: ghcr.io/<github-owner>  (sem barra no final)
# Ex: ghcr.io/minha-org
# -----------------------------------------------------------------------------

GHCR_IMAGE_PREFIX=ghcr.io/sua-org-aqui

# -----------------------------------------------------------------------------
# Domínio e TLS (Caddy + Let's Encrypt)
# -----------------------------------------------------------------------------

# Domínio público da aplicação (sem https://)
# Ex: radar.suaempresa.com.br
DOMAIN=radar.suaempresa.com.br

# E-mail para notificações de expiração do certificado TLS
ACME_EMAIL=ti@suaempresa.com.br

# -----------------------------------------------------------------------------
# PostgreSQL
# IMPORTANTE: DATABASE_URL usa "postgres" como host (nome do serviço Docker),
# não "localhost". O container web/workers resolve pelo nome do serviço.
# -----------------------------------------------------------------------------

POSTGRES_USER=radar
POSTGRES_PASSWORD=SENHA_FORTE_AQUI_MINIMO_32_CHARS
POSTGRES_DB=radar_db

# Não altere — o docker-compose.prod.yml constrói a URL automaticamente
# a partir das variáveis acima. Esta URL é para referência externa (ex: psql da VPS).
# DATABASE_URL_EXTERNAL=postgresql://radar:SENHA@localhost:5432/radar_db

# Tuning de PostgreSQL (ajuste conforme a RAM da VPS):
#   VPS 8GB  → shared_buffers=2GB, effective_cache_size=6GB
#   VPS 16GB → shared_buffers=4GB, effective_cache_size=12GB
#   VPS 32GB → shared_buffers=8GB, effective_cache_size=24GB
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB

# -----------------------------------------------------------------------------
# Redis
# A URL completa para os workers/web: usa "redis" como host (serviço Docker).
# REDIS_URL é construída automaticamente pelo docker-compose com a senha abaixo.
# -----------------------------------------------------------------------------

REDIS_PASSWORD=SENHA_FORTE_REDIS_AQUI

# Não altere — o docker-compose.prod.yml injeta REDIS_URL=redis://:REDIS_PASSWORD@redis:6379
# Esta variável é para referência.
# REDIS_URL=redis://:SENHA@localhost:6379

# -----------------------------------------------------------------------------
# Next.js / Auth.js
# -----------------------------------------------------------------------------

# Secret para assinar JWTs de sessão.
# Gere com: openssl rand -base64 32
AUTH_SECRET=GERE_COM_openssl_rand_-base64_32

# URL pública da aplicação (com https://)
AUTH_URL=https://radar.suaempresa.com.br

# URL base pública (Next.js usa para resolver links absolutos)
NEXT_PUBLIC_APP_URL=https://radar.suaempresa.com.br

# -----------------------------------------------------------------------------
# Seed — usuário admin inicial
# Usado apenas uma vez para criar o primeiro usuário.
# Remova ou deixe em branco após o seed.
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_PASSWORD=SENHA_ADMIN_INICIAL_TROQUE_APOS_LOGIN

# -----------------------------------------------------------------------------
# Cloudflare R2 — armazenamento de exportações CSV
#
# Criar um bucket no R2 e gerar um API token com permissão de leitura/escrita.
# Console: https://dash.cloudflare.com → R2 → Create bucket
# API token: Account Settings → API Tokens → Create Token (R2 Edit)
# -----------------------------------------------------------------------------

# Endpoint do R2 (formato: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# Access Key ID do token R2
R2_ACCESS_KEY_ID=SEU_R2_ACCESS_KEY_ID

# Secret Access Key do token R2
R2_SECRET_ACCESS_KEY=SEU_R2_SECRET_ACCESS_KEY

# Nome do bucket criado no R2
R2_BUCKET=radar-exports

# URL pública do bucket (habilitar "Public Access" no bucket ou usar domínio customizado)
# Ex: https://pub-HASH.r2.dev  ou  https://exports.suaempresa.com.br
R2_PUBLIC_URL=https://pub-SEU_HASH.r2.dev

# Tempo de validade das URLs pré-assinadas de download (em horas)
CNPJ_EXPORT_PRESIGNED_URL_EXPIRY_HOURS=4

# -----------------------------------------------------------------------------
# Google APIs
# -----------------------------------------------------------------------------

# Chave da Google Places API (backend — usada pelo worker de enriquecimento)
# Console: https://console.cloud.google.com → APIs & Services → Credentials
# Restringir por IP da VPS + APIs: Places API
GOOGLE_PLACES_API_KEY=AIza...

# Chave da Google Maps JS API (frontend — exposta no HTML, restringir por domínio)
# Restringir por Referenciador HTTP: https://radar.suaempresa.com.br/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# TTL do cache de Places em dias (default: 30)
PLACES_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Geocodificação sob demanda (cascata CNEFE → BrasilAPI CEP → Google) —
# ver CLAUDE.md § "Estratégia de geocodificação / enriquecimento externo"
# -----------------------------------------------------------------------------

# Chave da Google Geocoding API — mesmo projeto/chave de GOOGLE_PLACES_API_KEY,
# só precisa ter "Geocoding API" habilitada nas API restrictions dela.
# Etapa paga da cascata, sempre como fallback final.
GOOGLE_MAPS_API_KEY=AIza...

# UFs já importadas localmente via import:cnefe — informativo, não lido pelo
# código (a idempotência do import já verifica o banco diretamente).
# CNEFE_IMPORTED_UFS=

# Teto de chamadas pagas (Google Geocoding) por job da fila geocode-enrichment.
# Nunca deixe sem limite — custo é recurso finito.
GEOCODE_ENRICHMENT_GOOGLE_CAP_PER_JOB=20

# -----------------------------------------------------------------------------
# Backup automático do PostgreSQL → R2
#
# Use um bucket R2 SEPARADO de radar-exports para isolar dumps de banco
# dos arquivos de exportação de usuários (políticas de acesso independentes).
#
# R2_BACKUP_ENDPOINT / R2_BACKUP_ACCESS_KEY_ID / R2_BACKUP_SECRET_ACCESS_KEY
# são opcionais — se não definidos, usam as credenciais R2_* acima como fallback.
# Se o bucket de backup estiver na mesma conta R2, basta definir R2_BACKUP_BUCKET.
# -----------------------------------------------------------------------------

R2_BACKUP_BUCKET=radar-backups
# R2_BACKUP_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BACKUP_ACCESS_KEY_ID=SEU_ACCESS_KEY_BACKUP
# R2_BACKUP_SECRET_ACCESS_KEY=SEU_SECRET_KEY_BACKUP

# -----------------------------------------------------------------------------
# Resend — e-mail transacional (fase futura)
# -----------------------------------------------------------------------------

# RESEND_API_KEY=re_...
