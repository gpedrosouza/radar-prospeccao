# =============================================================================
# apps/web/.env.local — variáveis carregadas pelo Next.js.
# Copie para apps/web/.env.local e preencha os valores.
# Este arquivo (.env.local) é git-ignorado — nunca commitar segredos reais.
# =============================================================================

# URL completa usada pelo Prisma — mesma de DATABASE_URL na raiz do repo.
DATABASE_URL=postgresql://radar:radar_dev_password@localhost:5432/radar_db?schema=public

# -----------------------------------------------------------------------------
# Autenticação — Next.js (Auth.js / next-auth v5)
# -----------------------------------------------------------------------------

# Secret usado para assinar e verificar os JWTs de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=TROQUE_POR_UM_SECRET_SEGURO_32_CHARS_MINIMO

# URL base do app Next.js — inclua protocolo e porta.
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seed de desenvolvimento — usuário admin inicial (packages/db/seeds/create-admin.ts)
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@radar.dev
SEED_ADMIN_PASSWORD=troque_esta_senha

# -----------------------------------------------------------------------------
# Google Maps / Places — tela de Mapa
# -----------------------------------------------------------------------------

# Chave restrita por HTTP referrer, com Maps JavaScript API + Places API (New)
# habilitadas nas API restrictions (o PlaceAutocompleteElement chama Places
# (New) direto do navegador — ver histórico de troubleshooting do projeto).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave restrita por IP, com Places API (New) habilitada — usada só no backend
# (/api/places/companies).
GOOGLE_PLACES_API_KEY=

# Diretório-raiz dos arquivos de exportação local (relativo ao CWD do Next.js
# = apps/web/). "../.." aponta para a raiz do monorepo, onde o Docker volume
# monta ./exports/. Em produção com R2, esta variável não é usada.
EXPORT_LOCAL_DIR=../..

# -----------------------------------------------------------------------------
# Resend — e-mail transacional (campanhas, unsubscribe, webhook)
# Fase 5 (LGPD aprovada antes de ativar em produção).
# -----------------------------------------------------------------------------

# Chave de API do Resend (obtenha em resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endereço "from" — DEVE ser de um domínio verificado no Resend.
RESEND_FROM_EMAIL=Radar Prospecção <noreply@seu-dominio.com.br>

# Signing secret do webhook — Resend → Webhooks → (seu endpoint) → Signing Secret,
# depois de configurar https://seu-dominio.com.br/api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret para assinar tokens de descadastro HMAC-SHA256. Gere com: openssl rand -hex 32
UNSUBSCRIBE_TOKEN_SECRET=TROQUE_POR_UM_SECRET_SEGURO_32_CHARS_MINIMO

# URL pública usada para montar links absolutos nos e-mails e no agendamento.
# Deve incluir protocolo e domínio, sem barra final.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Agendamento de reuniões — página pública /agende (Google Calendar API)
#
# Service Account com domain-wide delegation para a Calendar API — usada para
# consultar disponibilidade e criar eventos no calendário de agendamento da GR
# sem exigir OAuth por lead. Criar em console.cloud.google.com > IAM & Admin >
# Service Accounts, habilitar domain-wide delegation no Admin Console do
# Workspace, escopo: https://www.googleapis.com/auth/calendar
# -----------------------------------------------------------------------------

# GOOGLE_SCHEDULING_SA_EMAIL=
# GOOGLE_SCHEDULING_SA_PRIVATE_KEY=
# GOOGLE_SCHEDULING_CALENDAR_ID=agenda@grgestaofinanceira.com.br
# GOOGLE_SCHEDULING_IMPERSONATE_EMAIL=agenda@grgestaofinanceira.com.br

# Regras de negócio do agendamento (não vêm da API do Google, são definidas por nós)
# SCHEDULING_MEETING_DURATION_MINUTES=30
# SCHEDULING_BUFFER_MINUTES=15
# SCHEDULING_MIN_NOTICE_HOURS=4
# SCHEDULING_BUSINESS_HOURS_START=09:00
# SCHEDULING_BUSINESS_HOURS_END=18:00
