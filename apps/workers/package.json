  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@radar/db": "*",
    "@radar/shared": "*",
    "bullmq": "^5.0.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.0.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.0.0",
    "pg": "^8.13.3",
    "pg-copy-streams": "^6.0.6",
    "resend": "^4.8.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.3",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
