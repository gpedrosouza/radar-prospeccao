{
  "name": "@radar/workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "import:receita": "tsx --env-file=.env src/scripts/import-receita/index.ts",
    "db:analyze": "tsx --env-file=.env src/scripts/analyze-cnpj.ts",
    "analytics:refresh": "tsx --env-file=.env src/scripts/analytics/refresh.ts",
    "geocode:cnpj": "tsx --env-file=.env src/scripts/geocode-cnpj.ts",
    "import:cnefe": "tsx --env-file=.env src/scripts/import-cnefe.ts",
    "import:cnefe-ceps": "tsx --env-file=.env src/scripts/import-cnefe-ceps.ts",
    "reenrich:municipio-level": "tsx --env-file=.env src/scripts/reenrich-municipio-level.ts",
    "backfill:cnefe": "tsx --env-file=.env src/scripts/backfill-cnefe.ts",
    "import:cities": "tsx --env-file=.env src/scripts/import-cities.ts",
    "match:municipio-codigo-rf": "tsx --env-file=.env src/scripts/match-municipio-codigo-rf.ts",
    "test:queue": "tsx --env-file=.env src/scripts/test-export-queue.ts",
    "test:sse": "tsx --env-file=.env src/scripts/test-sse-stream.ts",
    "cleanup:places-cache": "tsx --env-file=.env src/scripts/cleanup-places-cache.ts",
    "seed:test-emails": "tsx --env-file=.env src/scripts/seed-test-emails.ts",
    "backup": "tsx --env-file=.env src/scripts/backup-postgres.ts",
    "restore": "tsx --env-file=.env src/scripts/restore-postgres.ts"
