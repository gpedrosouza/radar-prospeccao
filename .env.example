# =============================================================================
# Radar Prospecção — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o Docker.
# O .env nunca é commitado (está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (usado pelo docker-compose e pela DATABASE_URL do Prisma)
# -----------------------------------------------------------------------------

# Usuário criado automaticamente pelo container na primeira inicialização
POSTGRES_USER=radar

# Senha do usuário acima — use algo seguro em staging/produção
POSTGRES_PASSWORD=radar_dev_password

# Nome do banco criado automaticamente
POSTGRES_DB=radar_db

# Host exposto pelo Docker (localhost para dev local)
POSTGRES_HOST=localhost

# Porta mapeada no host — altere se 5432 já estiver em uso
POSTGRES_PORT=5432

# URL completa usada pelo Prisma e qualquer outro cliente Node.
# Formato: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://radar:radar_dev_password@localhost:5432/radar_db?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Porta mapeada no host — altere se 6379 já estiver em uso
REDIS_PORT=6379

# URL usada pelos workers e pelo app web para filas / cache
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Aplicação web (Next.js) — descomente quando o serviço web for ativado
# -----------------------------------------------------------------------------

# WEB_PORT=3000

# URL pública do app (usada pelo Next.js para absolute URLs em SSR)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Autenticação — Next.js (Auth.js / next-auth v5)
# -----------------------------------------------------------------------------

# Secret usado para assinar e verificar os JWTs de sessão.
# Gere com: openssl rand -base64 32
# NUNCA use o valor de exemplo em staging ou produção.
AUTH_SECRET=TROQUE_POR_UM_SECRET_SEGURO_32_CHARS_MINIMO

# URL base do app Next.js. Necessária para que o next-auth resolva callbacks OAuth
# e valide o host nas requisições de auth. Inclua protocolo e porta.
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seed de desenvolvimento — usuário admin inicial
# Lido pelo script packages/db/seeds/create-admin.ts
# Adicione também em packages/db/.env para o script de seed encontrar
# -----------------------------------------------------------------------------

# E-mail do usuário admin criado pelo seed
SEED_ADMIN_EMAIL=admin@radar.dev

# Senha em texto plano — será hasheada com argon2 pelo seed
SEED_ADMIN_PASSWORD=troque_esta_senha

# -----------------------------------------------------------------------------
# MinIO / Cloudflare R2 — armazenamento de arquivos de exportação
#
# Em desenvolvimento: use os valores do MinIO local (docker-compose).
# Em produção: substitua pelo endpoint e credenciais do Cloudflare R2.
# Console MinIO local: http://localhost:9001 (user: minioadmin / minioadmin)
# -----------------------------------------------------------------------------

# Endpoint S3-compatível. MinIO local: http://localhost:9000
# R2 produção: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000

# Credenciais. MinIO local usa minioadmin/minioadmin por padrão.
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin

# Nome do bucket (criado automaticamente pelo minio-init no docker-compose).
R2_BUCKET=radar-exports

# URL pública do bucket (para links de download sem presigned URL, se necessário).
# MinIO local: http://localhost:9000/radar-exports
# R2 produção: https://pub-<ID>.r2.dev
R2_PUBLIC_URL=http://localhost:9000/radar-exports

# TTL das URLs pré-assinadas de download, em horas.
CNPJ_EXPORT_PRESIGNED_URL_EXPIRY_HOURS=4

# Portas do MinIO expostas no host (altere se já estiverem em uso)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Backup automático do PostgreSQL → R2/MinIO
#
# Bucket SEPARADO de radar-exports para não misturar dumps de banco com
# arquivos de exportação de usuários.
#
# Em dev: usa as mesmas credenciais do MinIO (minioadmin/minioadmin),
#         mas bucket diferente (radar-backups, criado pelo minio-init).
# Em prod: idealmente um bucket R2 diferente com política de acesso restrita.
#
# R2_BACKUP_ENDPOINT / R2_BACKUP_ACCESS_KEY_ID / R2_BACKUP_SECRET_ACCESS_KEY
# são opcionais — se não definidos, fazem fallback para R2_* acima.
# -----------------------------------------------------------------------------

R2_BACKUP_BUCKET=radar-backups
# R2_BACKUP_ENDPOINT=http://localhost:9000
# R2_BACKUP_ACCESS_KEY_ID=minioadmin
# R2_BACKUP_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# APIs externas — preencha conforme necessário
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# E-mail transacional — Resend
#
# Fase 5 (LGPD aprovada antes de ativar em produção).
# Documentação de configuração de domínio: docs/resend-setup.md
# -----------------------------------------------------------------------------

# Chave de API do Resend (obtenha em resend.com/api-keys)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endereço "from" dos e-mails enviados.
# DEVE ser de um domínio verificado no Resend (NUNCA Gmail, Hotmail, etc.).
# Exemplo: "Radar Prospecção <noreply@seu-dominio.com.br>"
# RESEND_FROM_EMAIL=Radar Prospecção <noreply@seu-dominio.com.br>

# Endereço de resposta (Reply-To). Opcional: se definido, respostas dos leads
# caem aqui, independentemente do From acima. Deixe em branco para não enviar o header.
# RESEND_REPLY_TO=administrativo@grgestaofinanceira.com.br

# Delay entre envios individuais em ms (default: 350).
# Valor mínimo recomendado: 100ms. Aumentar para maior reputação de remetente.
# EMAIL_SEND_DELAY_MS=350

# Secret para assinar tokens de descadastro (HMAC-SHA256).
# Gere com: openssl rand -base64 32
# NUNCA use o valor de exemplo em produção.
# UNSUBSCRIBE_TOKEN_SECRET=TROQUE_POR_UM_SECRET_SEGURO_32_CHARS_MINIMO

# Secret do webhook do Resend (formato whsec_<base64>).
# Obtenha no painel do Resend → Webhooks → (seu endpoint) → Signing Secret.
# NUNCA compartilhe ou exponha em logs.
# RESEND_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL pública do app (usada pelo worker para montar links de descadastro).
# Deve incluir protocolo e domínio, sem barra final.
# APP_URL=https://seu-dominio.com.br

# Chave da Google Places API (necessária para busca de empresas no mapa)
# GOOGLE_PLACES_API_KEY=

# Chave da Google Maps JavaScript API (necessária para o mapa no frontend)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# TTL do cache geográfico do Google Places, em dias (default: 30).
# Reduzir em ambientes onde os dados de POI mudam com mais frequência.
PLACES_CACHE_TTL_DAYS=30

# Tamanho da célula do grid de cache em graus (default: 0.1 ≈ 11 km).
# Não altere em produção sem limpar o cache existente.
# PLACES_CACHE_CELL_DEGREES=0.1

# -----------------------------------------------------------------------------
# Geocodificação sob demanda (cascata CNEFE → BrasilAPI CEP → Google) —
# ver CLAUDE.md § "Estratégia de geocodificação / enriquecimento externo"
# -----------------------------------------------------------------------------

# Chave da Google Geocoding API — mesmo projeto/chave de GOOGLE_PLACES_API_KEY,
# só precisa ter "Geocoding API" habilitada nas API restrictions dela.
# Usada por geocode-cnpj.ts (script manual) e pelo consumer da fila
# geocode-enrichment, sempre como fallback final (etapa paga da cascata).
# GOOGLE_MAPS_API_KEY=

# UFs já importadas localmente via import:cnefe — informativo, não lido pelo
# código (a idempotência do import já verifica o banco diretamente).
# CNEFE_IMPORTED_UFS=

# Teto de chamadas pagas (Google Geocoding) por job da fila geocode-enrichment.
# Nunca deixe sem limite — custo é recurso finito (ver CLAUDE.md).
GEOCODE_ENRICHMENT_GOOGLE_CAP_PER_JOB=20

# -----------------------------------------------------------------------------
# Agendamento de reuniões — página pública /agende (Google Calendar API)
# -----------------------------------------------------------------------------

# Service Account com domain-wide delegation para a Calendar API — usada para consultar
# disponibilidade e criar eventos no calendário de agendamento da GR sem OAuth por lead.
# Criar em console.cloud.google.com > IAM & Admin > Service Accounts, habilitar
# domain-wide delegation no Admin Console do Workspace, escopo:
# https://www.googleapis.com/auth/calendar
# GOOGLE_SCHEDULING_SA_EMAIL=
# GOOGLE_SCHEDULING_SA_PRIVATE_KEY=
# GOOGLE_SCHEDULING_CALENDAR_ID=agenda@grgestaofinanceira.com.br
# GOOGLE_SCHEDULING_IMPERSONATE_EMAIL=agenda@grgestaofinanceira.com.br

# Regras de negócio do agendamento (não vêm da API do Google, são definidas por nós)
# SCHEDULING_MEETING_DURATION_MINUTES=30
# SCHEDULING_BUFFER_MINUTES=15
# SCHEDULING_MIN_NOTICE_HOURS=4
# SCHEDULING_BUSINESS_HOURS_START=09:00
# SCHEDULING_BUSINESS_HOURS_END=18:00
